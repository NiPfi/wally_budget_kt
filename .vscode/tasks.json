{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "android-debug-prepare",
            "type": "shell",
            "command": "bash .vscode/android-debug-prepare.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "android-debug-cleanup",
            "type": "shell",
            "command": "bash .vscode/android-debug-cleanup.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
